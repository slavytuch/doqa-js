{
  "name": "doqa-jest-dev",
  "version": "0.1.1",
  "description": "DoQA adapter for Jest: results, test plans, steps and attachments",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./reporter": "./dist/reporter.js",
    "./environment-node": "./dist/environment-node.js",
    "./environment-jsdom": "./dist/environment-jsdom.js",
    "./sequencer": "./dist/sequencer.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node ../scripts/esm.cjs",
    "test": "node --test tests/*.test.cjs",
    "prepack": "npm run build",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@jest/test-sequencer": "^29.7.0 || ^30.0.0",
    "jest": "^29.7.0 || ^30.0.0",
    "jest-environment-jsdom": "^29.7.0 || ^30.0.0",
    "jest-environment-node": "^29.7.0 || ^30.0.0"
  },
  "peerDependenciesMeta": {
    "jest-environment-jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0"
  },
  "dependencies": {
    "doqa-js-commons-dev": "0.1.1"
  }
}
