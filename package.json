{
  "name": "doqa-js",
  "version": "0.1.1",
  "private": true,
  "description": "DoQA JavaScript client, shared adapter core and framework adapters",
  "license": "Apache-2.0",
  "workspaces": [
    "doqa-client",
    "doqa-js-commons",
    "doqa-jest"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "lint": "npm run build && npm run lint --workspaces",
    "test": "npm run build && npm run test --workspaces",
    "pack": "npm run build && node scripts/pack.cjs",
    "version:check": "node scripts/check-version.cjs",
    "test:packages": "node scripts/test-packages.cjs",
    "version:set": "node scripts/version.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
